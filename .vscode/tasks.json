{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/TerminalApi/TerminalApi.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Init dev DB",
      "type": "process",
      "command": "sqlcmd",
      "args": ["-S", "(localdb)\\MSSQLLocalDB", "-E", "-b", "-i", "${workspaceFolder}\\dev\\db\\init-dev-db.sql"],
      "problemMatcher": []
    },
    {
      "label": "Prepare stand",
      "dependsOn": ["Init dev DB", "Build API"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run API",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/backend/TerminalApi"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(Building|Сборка|Determining|Используются)",
          "endsPattern": "(Application started|Now listening on)"
        }
      }
    },
    {
      "label": "Run Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Run All",
      "dependsOn": ["Run API", "Run Frontend"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
